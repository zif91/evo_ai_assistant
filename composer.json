{
    "name": "evocms/ai-assistant",
    "description": "AI Assistant for Evolution CMS - Shopify Sidekick-like assistant for managing content",
    "type": "evocms-package",
    "keywords": [
        "evolutioncms",
        "ai",
        "assistant",
        "chatbot",
        "cms"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Evolution CMS Community",
            "email": "community@evo.im"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "EvolutionCMS\\AiAssistant\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EvolutionCMS\\AiAssistant\\AiAssistantServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "illuminate/database": "^8.83",
        "illuminate/events": "^8.83",
        "illuminate/http": "^8.83",
        "illuminate/routing": "^8.83",
        "illuminate/view": "^8.83",
        "illuminate/translation": "^8.83",
        "illuminate/config": "^8.83",
        "illuminate/log": "^8.83"
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    }
}
